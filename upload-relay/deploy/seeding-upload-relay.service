[Unit]
Description=RelaySeed upload streaming relay (RU VDS)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/seeding-upload-relay
EnvironmentFile=-/opt/seeding-upload-relay/relay.env
ExecStart=/opt/seeding-upload-relay/.venv/bin/uvicorn seeding_upload_relay.main:app --host 127.0.0.1 --port 8091
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
