# Caddy — HTTPS-фронт CT400 (Фаза 5) + прокси загрузки /u/b и /u/a.
# Терминирует TLS и отдаёт SPA/API на web (nginx). Локальный CA (local_certs).
# Браузеру один раз доверить root.crt:
#   docker compose ... cp caddy:/data/caddy/pki/authorities/local/root.crt ./caddy-root.crt
#
# Публичный NPM на seedbox2 тоже держит /u/b → 171:8090 и /u/a → 243:8090.
# Эти handle_path нужны, когда клиент приходит на Caddy (LAN IP или те же имена).
# handle_path снимает префикс: /u/b/b1/upload/v1/… → 171:8090/b1/upload/v1/…

{
	local_certs
	default_sni {$SEEDING_SITE:192.168.1.101}
}

{$SEEDING_SITE:192.168.1.101}, seedbox2.hw-s.ru, seedbox.hw-s.ru {
	encode gzip

	handle_path /u/b/* {
		reverse_proxy 192.168.1.171:8090
	}
	handle_path /u/a/* {
		reverse_proxy 192.168.2.243:8090
	}

	reverse_proxy web:80
}
